#!/usr/bin/env bash
#
# Hook pre-commit: gli stessi controlli bloccanti della CI, ma solo sui file in
# stage, cosi' il feedback arriva in circa un secondo invece che in due minuti.
#
# GENERATO da wp-plugin-install-hooks: non modificarlo qui, le modifiche vanno
# fatte in nigrosimone/wp-plugin-ci e arrivano col prossimo composer install.
#
# Per saltarlo una volta: git commit --no-verify
#
# Nota: questo hook e' una comodita', non una garanzia. La garanzia e' la CI,
# che non si puo' aggirare.

set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1

STAGED_PHP="$(git diff --cached --name-only --diff-filter=ACM -- '*.php')"
STAGED_ALL="$(git diff --cached --name-only --diff-filter=ACM)"

FAILED=0

fail() {
    echo ""
    echo "  pre-commit: $1"
    FAILED=1
}

if [ -n "$STAGED_PHP" ]; then
    # 1) Sintassi
    while IFS= read -r file; do
        [ -f "$file" ] || continue
        if ! php -l "$file" > /dev/null 2>&1; then
            php -l "$file"
            fail "errore di sintassi in $file"
        fi
    done <<< "$STAGED_PHP"

    # 2) Stile: il conteggio deve restare a zero
    if [ -x vendor/bin/phpcs ]; then
        # shellcheck disable=SC2086
        if ! vendor/bin/phpcs --report=full $STAGED_PHP; then
            fail "violazioni di stile. Prova: composer phpcbf"
        fi
    fi
fi

# 3) Test: durano meno di un secondo, conviene averli sempre.
if [ -x vendor/bin/phpunit ]; then
    if ! vendor/bin/phpunit --no-coverage --do-not-cache-result > /dev/null 2>&1; then
        vendor/bin/phpunit --no-coverage --do-not-cache-result
        fail "test falliti"
    fi
fi

# 4) Coerenza delle versioni, se il commit tocca il readme o un file PHP.
if [ -n "$STAGED_PHP" ] || echo "$STAGED_ALL" | grep -q '^readme\.txt$'; then
    if [ -x vendor/bin/wp-plugin-check-version ]; then
        if ! vendor/bin/wp-plugin-check-version > /dev/null 2>&1; then
            vendor/bin/wp-plugin-check-version
            fail "versioni non coerenti tra header del plugin e readme.txt"
        fi
    fi
fi

if [ "$FAILED" -ne 0 ]; then
    echo ""
    echo "  Commit annullato. Per forzarlo comunque: git commit --no-verify"
    echo ""
    exit 1
fi

exit 0
